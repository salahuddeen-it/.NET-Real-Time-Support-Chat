@model AgentsViewModel
@{ ViewData["Title"] = "Support Agents"; }
<div class="container-fluid px-lg-4 py-4">
    <h1 class="page-title mb-1">Support Agents</h1>
    <p class="text-muted">Manage your team. Online status updates in real time.</p>

    <div class="row g-4">
        <div class="col-xl-8">
            <div class="card glass-card overflow-hidden">
                <div class="table-responsive">
                    <table class="table ticket-table align-middle mb-0">
                        <thead>
                            <tr><th>Agent</th><th class="text-center">Active</th><th class="text-center">Resolved</th><th class="text-center">Status</th><th class="text-end">Account</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Model.Agents)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="avatar sm presence @(a.IsOnline ? "online" : "")" data-presence="@a.Id" style="background:@UI.AvatarColor(a.Id)">@UI.Initials(a.FullName)</span>
                                            <div><div class="fw-semibold">@a.FullName</div><div class="small text-muted">@a.Email</div></div>
                                        </div>
                                    </td>
                                    <td class="text-center fw-bold">@a.ActiveTickets</td>
                                    <td class="text-center">@a.ResolvedTickets</td>
                                    <td class="text-center">
                                        <span class="presence-label @(a.IsOnline ? "online" : "")" data-presence="@a.Id"><span class="dot"></span><span class="txt-online">Online</span><span class="txt-offline">Offline</span></span>
                                    </td>
                                    <td class="text-end">
                                        <form asp-action="ToggleAgent" asp-route-id="@a.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm @(a.IsActive ? "btn-light border" : "btn-outline-success")">@(a.IsActive ? "Deactivate" : "Activate")</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="card glass-card">
                <div class="card-body p-4">
                    <h6 class="section-title mb-3"><i class="bi bi-person-plus me-1"></i> Add new agent</h6>
                    <form asp-action="CreateAgent" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                        <div class="mb-3">
                            <label asp-for="NewAgent.FullName" class="form-label fw-semibold"></label>
                            <input asp-for="NewAgent.FullName" class="form-control" />
                            <span asp-validation-for="NewAgent.FullName" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="NewAgent.Email" class="form-label fw-semibold"></label>
                            <input asp-for="NewAgent.Email" class="form-control" />
                            <span asp-validation-for="NewAgent.Email" class="text-danger small"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="NewAgent.Password" class="form-label fw-semibold"></label>
                            <input asp-for="NewAgent.Password" class="form-control" />
                            <span asp-validation-for="NewAgent.Password" class="text-danger small"></span>
                        </div>
                        <button type="submit" class="btn btn-gradient w-100">Create Agent</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
