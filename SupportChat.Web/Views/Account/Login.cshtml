@model LoginViewModel
@{ ViewData["Title"] = "Login"; }
<div class="auth-wrap">
    <div class="auth-card">
        <div class="text-center mb-4">
            <span class="brand-icon lg mx-auto mb-3"><i class="bi bi-chat-dots-fill"></i></span>
            <h3 class="fw-bold mb-1">Welcome back</h3>
            <p class="text-muted mb-0">Login to your SupportDesk account</p>
        </div>
        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-semibold"></label>
                <div class="input-icon"><i class="bi bi-envelope"></i><input asp-for="Email" class="form-control" placeholder="you@example.com" autofocus /></div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label fw-semibold"></label>
                <div class="input-icon"><i class="bi bi-lock"></i><input asp-for="Password" class="form-control" placeholder="••••••" /></div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="form-check mb-4">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>
            <button type="submit" class="btn btn-gradient w-100 py-2">Login <i class="bi bi-arrow-right ms-1"></i></button>
        </form>
        <p class="text-center text-muted small mt-4 mb-3">Don't have an account? <a asp-action="Register" class="fw-semibold">Create one</a></p>
        <div class="demo-box">
            <div class="fw-semibold small mb-2"><i class="bi bi-key me-1"></i> Demo accounts (click to fill)</div>
            <button type="button" class="demo-chip" data-email="customer@support.com" data-pass="Customer@123"><i class="bi bi-person"></i> Customer</button>
            <button type="button" class="demo-chip" data-email="agent1@support.com" data-pass="Agent@123"><i class="bi bi-headset"></i> Agent 1</button>
            <button type="button" class="demo-chip" data-email="agent2@support.com" data-pass="Agent@123"><i class="bi bi-headset"></i> Agent 2</button>
            <button type="button" class="demo-chip" data-email="admin@support.com" data-pass="Admin@123"><i class="bi bi-shield-check"></i> Admin</button>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        document.querySelectorAll(".demo-chip").forEach(b => b.addEventListener("click", () => {
            document.getElementById("Email").value = b.dataset.email;
            document.getElementById("Password").value = b.dataset.pass;
        }));
    </script>
}
