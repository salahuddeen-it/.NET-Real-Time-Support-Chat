@model RegisterViewModel
@{ ViewData["Title"] = "Create account"; }
<div class="auth-wrap">
    <div class="auth-card">
        <div class="text-center mb-4">
            <span class="brand-icon lg mx-auto mb-3"><i class="bi bi-person-plus-fill"></i></span>
            <h3 class="fw-bold mb-1">Create your account</h3>
            <p class="text-muted mb-0">Get help from our support team in real time</p>
        </div>
        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
            <div class="mb-3">
                <label asp-for="FullName" class="form-label fw-semibold"></label>
                <div class="input-icon"><i class="bi bi-person"></i><input asp-for="FullName" class="form-control" placeholder="Your full name" /></div>
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-semibold"></label>
                <div class="input-icon"><i class="bi bi-envelope"></i><input asp-for="Email" class="form-control" placeholder="you@example.com" /></div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="row g-3 mb-4">
                <div class="col-sm-6">
                    <label asp-for="Password" class="form-label fw-semibold"></label>
                    <input asp-for="Password" class="form-control" placeholder="Min 6 characters" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                    <input asp-for="ConfirmPassword" class="form-control" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>
            <button type="submit" class="btn btn-gradient w-100 py-2">Create Account</button>
        </form>
        <p class="text-center text-muted small mt-4 mb-0">Already registered? <a asp-action="Login" class="fw-semibold">Login</a></p>
    </div>
</div>
