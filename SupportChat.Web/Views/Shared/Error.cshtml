@{
    var code = ViewData["Code"] as int? ?? 500;
    ViewData["Title"] = code == 404 ? "Not found" : "Error";
}
<div class="container py-5">
    <div class="empty-state text-center mx-auto py-5" style="max-width:480px">
        <div class="empty-icon"><i class="bi @(code == 404 ? "bi-search" : code == 403 ? "bi-shield-lock" : "bi-exclamation-triangle")"></i></div>
        <h2 class="fw-bold">@(code == 404 ? "Page not found" : code == 403 ? "Access denied" : "Something went wrong")</h2>
        <p class="text-muted">@(code == 404 ? "The page or ticket you are looking for does not exist." : "Please try again or go back to your dashboard.")</p>
        <a href="/" class="btn btn-gradient mt-2"><i class="bi bi-house me-1"></i> Go Home</a>
    </div>
</div>
