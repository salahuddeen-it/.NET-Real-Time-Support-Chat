@using System.Security.Claims
@{
    var isAuth = User.Identity?.IsAuthenticated == true;
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
    var fullName = User.FindFirstValue(ClaimsPrincipalExtensions.FullNameClaim) ?? User.Identity?.Name ?? "";
    var isAdmin = User.IsInRole(AppRoles.Admin);
    var isAgent = User.IsInRole(AppRoles.Agent);
    var isStaff = isAdmin || isAgent;
    var roleLabel = isAdmin ? "Admin" : isAgent ? "Support Agent" : "Customer";
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · SupportDesk</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body data-auth="@(isAuth ? "true" : "false")" data-user-id="@userId" data-staff="@(isStaff ? "true" : "false")">
    <nav class="navbar navbar-expand-lg app-navbar sticky-top">
        <div class="container-fluid px-lg-4">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-icon"><i class="bi bi-chat-dots-fill"></i></span>
                Support<span class="text-gradient">Desk</span>
            </a>

            @if (isAuth)
            {
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"><i class="bi bi-list fs-3"></i></button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto ms-lg-4 gap-lg-1">
                        <li class="nav-item"><a class="nav-link @(controller == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2 me-1"></i> Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link @(controller == "Tickets" ? "active" : "")" asp-controller="Tickets" asp-action="Index"><i class="bi bi-ticket-perforated me-1"></i> Tickets</a></li>
                        @if (isAdmin)
                        {
                            <li class="nav-item"><a class="nav-link @(controller == "Admin" ? "active" : "")" asp-controller="Admin" asp-action="Agents"><i class="bi bi-people me-1"></i> Agents</a></li>
                        }
                    </ul>

                    <ul class="navbar-nav align-items-lg-center gap-2">
                        @if (!isStaff)
                        {
                            <li class="nav-item"><a class="btn btn-gradient btn-sm px-3" asp-controller="Tickets" asp-action="Create"><i class="bi bi-plus-lg me-1"></i> New Ticket</a></li>
                        }
                        <li class="nav-item">
                            <span class="conn-status" id="connStatus" title="Real-time connection"><span class="dot"></span><span class="label">Connecting…</span></span>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link bell-link" href="#" id="notifBell" role="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                                <i class="bi bi-bell"></i>
                                <span class="notif-count d-none" id="notifCount">0</span>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end notif-menu p-0 shadow">
                                <div class="notif-header">
                                    <span class="fw-bold">Notifications</span>
                                    <button type="button" class="btn btn-link btn-sm text-decoration-none p-0" id="markAllRead">Mark all as read</button>
                                </div>
                                <div class="notif-list" id="notifList"><div class="notif-empty">Loading…</div></div>
                            </div>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link d-flex align-items-center gap-2" href="#" data-bs-toggle="dropdown">
                                <span class="avatar sm" style="background:@UI.AvatarColor(userId)">@UI.Initials(fullName)</span>
                                <span class="d-none d-xl-inline lh-sm">
                                    <span class="d-block fw-semibold text-dark small">@fullName</span>
                                    <span class="d-block text-muted" style="font-size:.72rem">@roleLabel</span>
                                </span>
                                <i class="bi bi-chevron-down small text-muted"></i>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end shadow">
                                <span class="dropdown-item-text small text-muted">Signed in as<br /><b class="text-dark">@User.Identity?.Name</b></span>
                                <div class="dropdown-divider"></div>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Logout</button>
                                </form>
                            </div>
                        </li>
                    </ul>
                </div>
            }
            else
            {
                <div class="ms-auto d-flex gap-2">
                    <a class="btn btn-light border" asp-controller="Account" asp-action="Login">Login</a>
                    <a class="btn btn-gradient" asp-controller="Account" asp-action="Register">Get Started</a>
                </div>
            }
        </div>
    </nav>

    <form id="antiforgeryForm" class="d-none">@Html.AntiForgeryToken()</form>

    <div class="toast-area" id="toastArea">
        @if (TempData["Success"] is string ok)
        {
            <div class="app-toast success auto-hide"><i class="bi bi-check-circle-fill"></i><div>@ok</div></div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="app-toast danger auto-hide"><i class="bi bi-x-circle-fill"></i><div>@err</div></div>
        }
    </div>

    <main>
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @if (isAuth)
    {
        <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    }
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
